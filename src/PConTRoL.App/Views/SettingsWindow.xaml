<Window x:Class="PConTRoL.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PConTRoL – Einstellungen" Width="760" SizeToContent="Height" MinWidth="560" MinHeight="320"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBg}" Foreground="{StaticResource Fg}" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="Swatch" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="150" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <!-- Nur senkrecht scrollen: So bekommt der Inhalt die Fensterbreite, Textfelder wachsen mit und nichts wird rechts abgeschnitten. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="SettingsRoot" Margin="22,10,22,18">
        <TextBlock Text="Ordner" Style="{StaticResource Section}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Hauptordner" Style="{StaticResource Label}" />
            <TextBox x:Name="MainFolderBox" Grid.Column="1" />
            <Button Grid.Column="2" Content="…" Click="OnBrowseMain" Padding="12,4" />
            <TextBlock x:Name="MainFolderHint" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontSize="13"
                       Foreground="{StaticResource FgDim}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="Der Ordner, in dem _Input und _NestResult liegen (lokaler Pfad am Leitrechner bzw. Netzlaufwerk)." />
        </Grid>

        <TextBlock Text="Größe" Style="{StaticResource Section}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Programmfenster" Style="{StaticResource Label}" />
            <DockPanel Grid.Column="1" Margin="3,6">
                <TextBlock x:Name="MainScaleText" DockPanel.Dock="Right" Width="60" FontSize="15" TextAlignment="Right" VerticalAlignment="Center" />
                <Slider x:Name="MainScaleSlider" Minimum="75" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" ValueChanged="OnScaleChanged" />
            </DockPanel>
            <TextBlock Grid.Row="1" Text="Pop-up" Style="{StaticResource Label}" />
            <DockPanel Grid.Row="1" Grid.Column="1" Margin="3,6">
                <TextBlock x:Name="PopupScaleText" DockPanel.Dock="Right" Width="60" FontSize="15" TextAlignment="Right" VerticalAlignment="Center" />
                <Slider x:Name="PopupScaleSlider" Minimum="75" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" ValueChanged="OnScaleChanged" />
            </DockPanel>
        </Grid>
        <TextBlock FontSize="13" Foreground="{StaticResource FgDim}" Margin="140,2,0,0" TextWrapping="Wrap"
                   Text="100 % = Normalgröße. Vorschau sofort im Hauptfenster und im Pop-up; „Abbrechen“ stellt den alten Wert wieder her." />

        <TextBlock Text="Pop-up (Tray)" Style="{StaticResource Section}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Hintergrund" Style="{StaticResource Label}" />
            <Button x:Name="BgButton" Grid.Column="1" Style="{StaticResource Swatch}" Click="OnPickColor" Tag="bg" />
            <TextBlock Grid.Row="1" Text="Text" Style="{StaticResource Label}" />
            <Button x:Name="FgButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource Swatch}" Click="OnPickColor" Tag="fg" />
            <TextBlock Grid.Row="2" Text="Akzent" Style="{StaticResource Label}" />
            <Button x:Name="AccentButton" Grid.Row="2" Grid.Column="1" Style="{StaticResource Swatch}" Click="OnPickColor" Tag="accent" />
            <TextBlock Grid.Row="3" Text="Deckkraft" Style="{StaticResource Label}" />
            <DockPanel Grid.Row="3" Grid.Column="1" Margin="3,8">
                <TextBlock x:Name="OpacityText" DockPanel.Dock="Right" Width="60" FontSize="15" TextAlignment="Right" VerticalAlignment="Center" />
                <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" ValueChanged="OnOpacityChanged" />
            </DockPanel>
            <CheckBox x:Name="TopmostBox" Grid.Row="4" Grid.Column="1" Content="Immer im Vordergrund" Margin="3,4"
                      Checked="OnLookChanged" Unchecked="OnLookChanged" />
        </Grid>
        <TextBlock FontSize="13" Foreground="{StaticResource FgDim}" Margin="140,4,0,0" TextWrapping="Wrap"
                   Text="Änderungen sind sofort im Pop-up unten rechts zu sehen (Vorschau)." />

        <TextBlock Text="Teileliste (unten im Hauptfenster)" Style="{StaticResource Section}" />
        <StackPanel x:Name="PartColumnsPanel" />
        <DockPanel Margin="140,4,0,0">
            <Button DockPanel.Dock="Right" Content="Standard" Click="OnResetPartColumns" FontSize="14" Padding="12,4" VerticalAlignment="Top"
                    ToolTip="Ursprüngliche Namen und Reihenfolge, alle Spalten sichtbar" />
            <TextBlock FontSize="13" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Links steht der Originalname. Eigenen Namen eintragen, mit ▲/▼ die Reihenfolge ändern, Haken weg = Spalte ausblenden. Teile, die in allen angezeigten Spalten gleich sind, werden zu einer Zeile zusammengefasst; die Stückzahl steht in der festen ersten Spalte „ST“." />
        </DockPanel>

        <TextBlock Text="Programm" Style="{StaticResource Section}" />
        <CheckBox x:Name="AutostartBox" Content="Mit Windows starten (im Tray)" />
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock x:Name="VersionLabel" Style="{StaticResource Label}" />
            <Button x:Name="CheckUpdateButton" Grid.Column="1" Content="⟳  Nach Updates suchen" Click="OnCheckUpdate" FontSize="14"
                    ToolTip="Sucht auf GitHub nach einer neuen Version und lädt sie herunter" />
            <Button x:Name="InstallUpdateButton" Grid.Column="2" Content="Jetzt installieren" Click="OnInstallUpdate" FontSize="14"
                    FontWeight="Bold" Visibility="Collapsed"
                    ToolTip="Einstellungen speichern, PConTRoL kurz beenden, Update einspielen und neu starten" />
            <TextBlock x:Name="UpdateStatus" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" FontSize="14" TextWrapping="Wrap" Margin="3,2,0,0" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Speichern" IsDefault="True" Click="OnSave" MinWidth="130" />
            <Button Content="Abbrechen" IsCancel="True" MinWidth="130" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
