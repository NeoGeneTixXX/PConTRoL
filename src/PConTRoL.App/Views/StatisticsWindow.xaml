<Window x:Class="PConTRoL.App.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PConTRoL.App.Views"
        Title="PConTRoL – Statistik" Width="1280" Height="860" MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource Fg}">
    <Window.Resources>
        <Style x:Key="Legend" TargetType="Rectangle">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="RadiusX" Value="2" />
            <Setter Property="RadiusY" Value="2" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel x:Name="RootPanel">
        <!-- Kopfzeile: Zeitraum + Export -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⟳  Aktualisieren" Click="OnRefreshClick" />
                    <Button Content="Übersicht als CSV" Click="OnExportSummary"
                            ToolTip="Die angezeigte Übersicht je Material (mit Zeitraum-Filter) als CSV für Excel speichern" />
                    <Button Content="Platten als CSV" Click="OnExportBoards"
                            ToolTip="Alle Platten im gewählten Zeitraum einzeln als CSV für Excel speichern" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Statistik" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Accent}"
                               VerticalAlignment="Center" Margin="0,0,24,0" />
                    <TextBlock Text="Zeitraum" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="RangeBox" Width="190" FontSize="15" VerticalAlignment="Center"
                              SelectionChanged="OnRangeChanged">
                        <ComboBoxItem Content="Gesamter Zeitraum" Tag="all" IsSelected="True" />
                        <ComboBoxItem Content="Heute" Tag="today" />
                        <ComboBoxItem Content="Letzte 7 Tage" Tag="7d" />
                        <ComboBoxItem Content="Letzte 30 Tage" Tag="30d" />
                        <ComboBoxItem Content="Dieser Monat" Tag="month" />
                        <ComboBoxItem Content="Letzter Monat" Tag="lastmonth" />
                        <ComboBoxItem Content="Dieses Jahr" Tag="year" />
                        <ComboBoxItem Content="Letztes Jahr" Tag="lastyear" />
                        <ComboBoxItem Content="Benutzerdefiniert" Tag="custom" />
                    </ComboBox>
                    <TextBlock Text="von" FontSize="15" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <DatePicker x:Name="FromPicker" Width="165" FontSize="14" VerticalAlignment="Center"
                                SelectedDateChanged="OnDateChanged" />
                    <TextBlock Text="bis" FontSize="15" VerticalAlignment="Center" Margin="12,0,8,0" />
                    <DatePicker x:Name="ToPicker" Width="165" FontSize="14" VerticalAlignment="Center"
                                SelectedDateChanged="OnDateChanged" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Summe über alle Materialien -->
        <Border DockPanel.Dock="Top" Padding="16,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock x:Name="TotalText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
                <Rectangle Style="{StaticResource Legend}" Fill="{StaticResource ChartUsed}" />
                <TextBlock Text="Ausnutzung" FontSize="15" VerticalAlignment="Center" Margin="0,0,18,0" />
                <Rectangle Style="{StaticResource Legend}" Fill="{StaticResource ChartWaste}" />
                <TextBlock Text="Verschnitt" FontSize="15" VerticalAlignment="Center" />
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBg}" Padding="12,5">
            <TextBlock x:Name="StatusText" FontSize="13" Foreground="{StaticResource FgDim}" TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid>
            <TextBlock x:Name="EmptyText" FontSize="17" Foreground="{StaticResource FgDim}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="640"
                       Visibility="Collapsed" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Tiles" Margin="10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="290" Margin="8" Padding="16,12" CornerRadius="6"
                                    Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Material}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                                               Foreground="{StaticResource Accent}" MinHeight="48" />
                                    <views:PieChart Percent="{Binding Utilization}" Width="170" Height="170" Margin="0,8,0,12"
                                                    Fill="{StaticResource ChartUsed}" Rest="{StaticResource ChartWaste}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Rectangle Style="{StaticResource Legend}" Fill="{StaticResource ChartUsed}" />
                                        <TextBlock Grid.Column="1" Text="Ausnutzung" FontSize="15" />
                                        <TextBlock Grid.Column="2" Text="{Binding UtilizationText}" FontSize="15" FontWeight="Bold" />
                                        <Rectangle Grid.Row="1" Style="{StaticResource Legend}" Fill="{StaticResource ChartWaste}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Verschnitt" FontSize="15" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding WasteText}" FontSize="15" FontWeight="Bold" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Platten" FontSize="15" Margin="0,6,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Boards}" FontSize="15" FontWeight="Bold" Margin="0,6,0,0" />
                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding AreaText}" FontSize="13"
                                                   Foreground="{StaticResource FgDim}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
