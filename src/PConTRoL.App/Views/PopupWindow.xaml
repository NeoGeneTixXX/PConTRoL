<Window x:Class="PConTRoL.App.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PConTRoL – Maschine"
        Width="480" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False">
    <Border x:Name="Root" CornerRadius="10" Padding="16,12,16,14" BorderThickness="2">
        <StackPanel>
            <DockPanel x:Name="Header" Background="Transparent" Cursor="SizeAll" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="✕" Click="OnClose" Padding="8,2" FontSize="14" Margin="0"
                        Background="Transparent" BorderBrush="Transparent" ToolTip="Schließen" />
                <Button DockPanel.Dock="Right" Content="Hauptfenster" Click="OnOpenMain" Padding="8,2" FontSize="13" Margin="0,0,6,0"
                        Background="Transparent" />
                <TextBlock x:Name="HeaderText" Text="PConTRoL – an der Maschine" FontSize="14" VerticalAlignment="Center" Opacity="0.8" />
            </DockPanel>

            <TextBlock x:Name="RunningLabel" Text="LÄUFT GERADE" FontSize="13" FontWeight="Bold" />
            <TextBlock x:Name="CurrentName" Text="{Binding CurrentName}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0" />
            <TextBlock x:Name="CurrentInfo" Text="{Binding CurrentInfo}" FontSize="15" Opacity="0.85" TextWrapping="Wrap" Margin="0,2,0,10" />

            <TextBlock x:Name="NextLabel" Text="ALS NÄCHSTES" FontSize="13" FontWeight="Bold" Margin="0,0,0,4" />
            <ItemsControl x:Name="NextList" ItemsSource="{Binding Next}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Position}" FontSize="16" FontWeight="Bold" Opacity="0.7"
                                       Foreground="{Binding Foreground, ElementName=CurrentName}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontSize="16" TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding Foreground, ElementName=CurrentName}" />
                                <TextBlock Text="{Binding Info}" FontSize="13" Opacity="0.7"
                                           Foreground="{Binding Foreground, ElementName=CurrentName}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="Footer" Text="{Binding Footer}" FontSize="14" Opacity="0.7" Margin="34,4,0,0" />
        </StackPanel>
    </Border>
</Window>
