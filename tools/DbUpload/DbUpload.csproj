<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Legt ein Release von GitHub in der gemeinsamen Datenbank ab (wie beim CSV-NaViGaTOR), damit alle Rechner
    es sofort finden – auch die ohne GitHub-Verbindung. Aufruf nach jedem Release, im Ordner tools\DbUpload:
      dotnet run -c Release            (neuestes Release)
      dotnet run -c Release 1.14.0     (bestimmte Version)
    Die Verbindung kommt aus der Umgebungsvariable PCONTROL_DB oder aus den PConTRoL-Einstellungen dieses
    Windows-Benutzers (verschlüsselt in %APPDATA%\PConTRoL\settings.json). Ins Repository kommt sie nie.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PConTRoL.Core\PConTRoL.Core.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>
